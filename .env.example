# App
NEXT_PUBLIC_PRODUCT_NAME="Provenance"
NEXT_PUBLIC_SITE_TITLE="Provenance | A Journal of Art, Objects & Their Histories"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=true
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=true

# Password strength requirements (ASVS V2.1 / CASA 2.x)
# All default to false (length-only: 8–99 chars). Enable any to enforce additional
# rules on sign-up and password-reset forms via RefinedPasswordSchema.
# NEXT_PUBLIC_PASSWORD_REQUIRE_SPECIAL_CHARS=false
# NEXT_PUBLIC_PASSWORD_REQUIRE_NUMBERS=false
# NEXT_PUBLIC_PASSWORD_REQUIRE_UPPERCASE=false

# Supabase (from Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Daily Operations alerts (cron: /api/cron/operations-alerts). Use a long random string; Vercel sends Authorization: Bearer <secret>
CRON_SECRET=

# Stripe (from https://dashboard.stripe.com/apikeys and Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required for Stripe Connect embedded onboarding component
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs — use the Stripe Price ID (starts with price_xxx), NOT the dollar amount.
# Create Products & Prices in Stripe Dashboard, then copy each Price ID.
# Artist: $10/mo, $99/yr | Collector: $29.99/mo, $299.90/yr | Gallery: $99/mo, $990/yr
STRIPE_PRICE_ARTIST_MONTHLY=
STRIPE_PRICE_ARTIST_YEARLY=
STRIPE_PRICE_COLLECTOR_MONTHLY=
STRIPE_PRICE_COLLECTOR_YEARLY=
STRIPE_PRICE_GALLERY_MONTHLY=
STRIPE_PRICE_GALLERY_YEARLY=

# Optional: Apify (admin leads UI — https://console.apify.com/account#/integrations )
# APIFY_API_TOKEN=
# Optional actor id (username~actor-name). Defaults to poidata Google Maps Email Extractor.
# APIFY_LEADS_ACTOR_ID=poidata~google-maps-email-extractor

# Google Tag Manager & Google Ads conversion tracking
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18140035105

# Upstash Redis — distributed rate limiting across serverless instances.
# Create a free database at https://upstash.com and copy the REST URL and token.
# When absent, per-process in-memory fallback is used (fine for local dev).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Email send API secret — required in production; the /api/email/send route is disabled if unset.
# Use a long random string (e.g. openssl rand -hex 32).
EMAIL_API_SECRET=

# Optional: OpenAI, Resend, etc.
# OPENAI_API_KEY=
# RESEND_API_KEY=

# Planet Architecture (verticals)
# Set this per-deployment to scope the app to a specific planet.
# Values: artworks (default), collectibles, realestate, vehicles
# NEXT_PUBLIC_PLANET=artworks
# Legacy alias still read by @provenance/core: NEXT_PUBLIC_ISLAND

# Creator Websites — v1.5 Custom Domain add-on
# Vercel Domains API (for attaching user-owned custom domains to creator sites)
# Create a token at https://vercel.com/account/tokens with "Full Account" scope
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=   # found in Vercel Project → Settings → General → Project ID
# Stripe add-on price for custom domain feature (billed monthly or yearly)
# STRIPE_PRICE_CUSTOM_DOMAIN_MONTHLY=
# STRIPE_PRICE_CUSTOM_DOMAIN_YEARLY=

# In-app domain purchase (GoDaddy Domains API + Stripe one-time payment)
# Production keys: https://developer.godaddy.com/keys
# GODADDY_API_KEY=
# GODADDY_API_SECRET=
# OTE (sandbox) keys for local/staging — uses api.ote-godaddy.com when NODE_ENV !== production
# GODADDY_OTE_API_KEY=
# GODADDY_OTE_API_SECRET=
# Provenance legal entity contact used for WHOIS registration (privacy enabled)
# GODADDY_REGISTRANT_FIRST_NAME=
# GODADDY_REGISTRANT_LAST_NAME=
# GODADDY_REGISTRANT_EMAIL=
# GODADDY_REGISTRANT_PHONE=+1.5555551234
# GODADDY_REGISTRANT_ADDRESS_1=
# GODADDY_REGISTRANT_CITY=
# GODADDY_REGISTRANT_STATE=
# GODADDY_REGISTRANT_POSTAL_CODE=
# GODADDY_REGISTRANT_COUNTRY=US
# IP address recorded in GoDaddy purchase consent (optional)
# GODADDY_CONSENT_IP=

# Content-Security-Policy escape hatch: set to "1" ONLY if GTM custom HTML tags
# use eval() and you see CSP violations after removing 'unsafe-eval'.
# NEXT_PUBLIC_CSP_ALLOW_EVAL=0

# VirusTotal API key for server-side file upload AV scanning (free tier: 500 req/day).
# Obtain at https://www.virustotal.com/gui/my-apikey after creating a free account.
# When absent, hash-lookup scanning is skipped (fail-open).
# VIRUSTOTAL_API_KEY=

# Vercel Deployment (per-planet subdomains)
# provenance.guru         -> root app (artworks)
# collc.provenance.guru   -> apps/collectibles
# rest.provenance.guru    -> apps/realestate
# auto.provenance.guru    -> apps/vehicles
# api.provenance.guru     -> apps/api
