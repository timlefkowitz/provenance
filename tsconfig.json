{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Vendored makerkit packages — each has its own tsconfig and is checked independently.
    // Excluding from root prevents @supabase/ssr internal conditional-type mismatches
    // (e.g. __InternalSupabase overloads) from failing `next build --type-check`.
    // Workspace imports from src/ still resolve correctly via package.json exports.
    "makerkit",
    // Standalone planet apps have their own tsconfigs and are checked independently.
    "apps/api",
    "apps/collectibles",
    "apps/realestate",
    "apps/vehicles"
  ]
}
