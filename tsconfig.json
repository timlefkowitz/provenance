{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Dead legacy app scaffolds — not in pnpm-workspace.yaml, not built or deployed.
    // Excluded to prevent their pre-existing syntax/type errors from polluting
    // `tsc --noEmit` output on the active codebase.
    "makerkit/nextjs-saas-starter-kit-lite/apps/web",
    "makerkit/nextjs-saas-starter-kit-lite/apps/provenance",
    "makerkit/nextjs-saas-starter-kit-lite/apps/e2e",
    // Standalone planet apps have their own tsconfigs and are checked independently.
    "apps/api",
    "apps/collectibles",
    "apps/realestate",
    "apps/vehicles"
  ]
}
