{
  "name": "provence-app",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "pnpm with-env next dev --turbo | pino-pretty -c",
    "build": "next build",
    "build:local": "pnpm with-env next build",
    "start": "next start",
    "start:local": "pnpm with-env next start",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,md,json}\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "verify:seo": "bash scripts/verify-seo.sh",
    "build:planets": "pnpm --filter @provenance/collectibles --filter @provenance/api build",
    "build:planets:all": "pnpm --filter @provenance/collectibles --filter @provenance/realestate --filter @provenance/vehicles --filter @provenance/api build",
    "dev:vehicles": "pnpm --filter @provenance/vehicles dev",
    "dev:realestate": "pnpm --filter @provenance/realestate dev",
    "email:contrast": "tsx scripts/check-email-contrast.ts",
    "email:gen-auth": "tsx scripts/generate-auth-email-templates.ts",
    "with-env": "dotenv -e ./.env.local --",
    "postinstall": "node scripts/ensure-ffmpeg-static.cjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.210",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@kit/accounts": "workspace:*",
    "@kit/auth": "workspace:*",
    "@kit/i18n": "workspace:*",
    "@kit/next": "workspace:*",
    "@kit/supabase": "workspace:*",
    "@kit/ui": "workspace:*",
    "@provenance/core": "workspace:*",
    "@provenance/planet-artworks": "workspace:*",
    "@provenance/verification-engine": "workspace:*",
    "@supabase/supabase-js": "2.75.0",
    "@tanstack/react-query": "5.101.0",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.6.1",
    "ai": "^6.0.208",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.2.0",
    "file-type": "^22.0.1",
    "framer-motion": "^12.40.0",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.12.0",
    "marked": "^17.0.5",
    "next": "15.5.9",
    "next-themes": "0.4.6",
    "openai": "^4.73.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^16.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.0",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "stripe": "^17.5.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@kit/eslint-config": "workspace:*",
    "@kit/prettier-config": "workspace:*",
    "@kit/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.5.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.37.0",
    "pino-pretty": "13.1.3",
    "prettier": "^3.8.4",
    "tailwindcss": "4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "prettier": "@kit/prettier-config",
  "pnpm": {
    "overrides": {
      "react-is": "19.0.0",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@tanstack/react-query": "5.101.0"
    },
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
