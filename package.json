{
  "name": "provence-app",
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "pnpm with-env next dev --turbo | pino-pretty -c",
    "build": "next build",
    "build:local": "pnpm with-env next build",
    "start": "next start",
    "start:local": "pnpm with-env next start",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,md,json}\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "verify:seo": "bash scripts/verify-seo.sh",
    "build:planets": "pnpm --filter @provenance/collectibles --filter @provenance/api build",
    "build:planets:all": "pnpm --filter @provenance/collectibles --filter @provenance/realestate --filter @provenance/vehicles --filter @provenance/api build",
    "dev:vehicles": "pnpm --filter @provenance/vehicles dev",
    "dev:realestate": "pnpm --filter @provenance/realestate dev",
    "email:contrast": "tsx scripts/check-email-contrast.ts",
    "email:gen-auth": "tsx scripts/generate-auth-email-templates.ts",
    "fingerprints:backfill": "dotenv -e ./.env.local -- tsx scripts/backfill-artwork-fingerprints.ts",
    "with-env": "dotenv -e ./.env.local --",
    "postinstall": "node scripts/ensure-ffmpeg-static.cjs",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.307",
    "@apple/app-store-server-library": "3.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@kit/accounts": "workspace:*",
    "@kit/auth": "workspace:*",
    "@kit/i18n": "workspace:*",
    "@kit/next": "workspace:*",
    "@kit/supabase": "workspace:*",
    "@kit/ui": "workspace:*",
    "@provenance/core": "workspace:*",
    "@provenance/planet-artworks": "workspace:*",
    "@provenance/verification-engine": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "@stripe/connect-js": "^3.3.5",
    "@stripe/react-connect-js": "^3.3.5",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.101.0",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.6.1",
    "ai": "^6.0.304",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.2.0",
    "file-type": "^22.0.1",
    "framer-motion": "^12.40.0",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.12.0",
    "marked": "^17.0.5",
    "next": "15.5.27",
    "next-themes": "0.4.6",
    "onnxruntime-node": "1.21.0",
    "openai": "^4.73.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.0.0",
    "react-image-crop": "11.1.2",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "stripe": "^17.5.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@kit/eslint-config": "workspace:*",
    "@kit/prettier-config": "workspace:*",
    "@kit/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.7.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.5.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.37.0",
    "pino-pretty": "13.1.3",
    "prettier": "^3.8.4",
    "tailwindcss": "4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "prettier": "@kit/prettier-config",
  "pnpm": {
    "overrides": {
      "react-is": "19.0.0",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@tanstack/react-query": "5.101.0",
      "@babel/core": "7.29.6",
      "@xmldom/xmldom": "^0.8.15",
      "ajv": "6.14.0",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "2.1.3",
      "esbuild": "0.28.1",
      "flatted": "3.4.4",
      "form-data": "4.0.6",
      "js-yaml": "^4.3.2",
      "lodash": "4.18.1",
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.7",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.5",
      "postcss": "8.5.25",
      "qs": "^6.16.0",
      "sharp": "^0.35.5",
      "tar": "7.5.22",
      "turbo": "2.10.8",
      "eslint-config-turbo>turbo": "2.10.8",
      "eslint-plugin-turbo>turbo": "2.10.8",
      "vite": "7.3.5",
      "ws": "8.21.1",
      "@vercel/analytics>next": "15.5.27",
      "brace-expansion@5": "^5.0.12",
      "nanoid@3": "^3.3.18",
      "nanoid@5": "^5.1.16",
      "browserslist": "^4.28.7",
      "source-map-js": "^1.2.2",
      "fast-copy": "^4.1.0",
      "baseline-browser-mapping": "^2.11.0",
      "@humanfs/node": "^0.16.8",
      "prosemirror-view": "^1.42.3",
      "xcode>uuid": "^11.1.1"
    },
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
